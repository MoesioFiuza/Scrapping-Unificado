[Unit]
Description=Scraper Unificado (Gunicorn)
After=network.target postgresql.service docker.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/apps/scraper/repo
EnvironmentFile=/opt/apps/scraper/repo/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/apps/scraper/repo/venv/bin/gunicorn \
    --bind 127.0.0.1:8001 \
    --workers 2 \
    --timeout 620 \
    --access-logfile /opt/apps/scraper/repo/logs/gunicorn-access.log \
    --error-logfile /opt/apps/scraper/repo/logs/gunicorn-error.log \
    wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
