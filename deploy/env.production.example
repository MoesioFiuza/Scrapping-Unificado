# Copiar para /opt/scraper-unificado/.env no servidor
# cp deploy/env.production.example /opt/scraper-unificado/.env

FLASK_ENV=production
SECRET_KEY=SUBSTITUA-POR-STRING-ALEATORIA-LONGA

# Subpath público (nginx remove este prefixo ao encaminhar para o Gunicorn)
APPLICATION_ROOT=/scraper

# Base de dados — PostgreSQL no mesmo servidor (recomendado)
DATABASE_URL=postgresql+psycopg2://scraper:ALTERAR_SENHA@127.0.0.1:5432/scraper_unificado

# Super admin
SUPER_ADMIN_EMAIL=moesio.fiuza@valenca.adv.br

# Scraping headless no servidor Linux
HEADLESS_MODE=True
CHROME_DRIVER_PATH=/usr/bin/chromedriver
# EDGE_DRIVER_PATH=/usr/bin/msedgedriver

MAX_PROCESSOS_POR_SESSAO=1000
DELAY_ENTRE_PROCESSOS=0.5

# DataWeb (mesmo host, outro microserviço)
DATAWEB_BASE_URL=http://212.47.68.222/dataweb
DATAWEB_TIMEOUT_SECONDS=600

# Gunicorn (systemd usa estes valores)
GUNICORN_BIND=127.0.0.1:8001
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=620

# Cookies — activar quando HTTPS estiver configurado
# SESSION_COOKIE_SECURE=true
